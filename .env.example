# LOCAL DEVELOPMENT TEMPLATE — never deploy with sample values.
# For the separate WebDev Preview, leave GRADEFLOW_DATABASE_URL on local SQLite unless
# you deliberately choose an isolated external PostgreSQL instance. Do not use the
# WebDev-managed MySQL DATABASE_URL: GradeFlow is designed for PostgreSQL.
GRADEFLOW_ENVIRONMENT=development
GRADEFLOW_DATABASE_URL=sqlite:///./data/gradeflow.db
GRADEFLOW_SESSION_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
GRADEFLOW_COOKIE_SECURE=true
GRADEFLOW_AUTO_CREATE_SCHEMA=true
GRADEFLOW_STORAGE_BACKEND=local
GRADEFLOW_STORAGE_DIR=./storage/private
GRADEFLOW_MAX_UPLOAD_BYTES=20971520

# Local Docker Compose profile only. Replace all sample values before using it.
POSTGRES_USER=gradeflow
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=gradeflow
REDIS_PASSWORD=local-only-change-me
GRADEFLOW_RATE_LIMIT_URL=redis://:local-only-change-me@redis:6379/2
GRADEFLOW_CELERY_BROKER_URL=redis://:local-only-change-me@redis:6379/0
GRADEFLOW_CELERY_RESULT_BACKEND=redis://:local-only-change-me@redis:6379/1
# Compose uses these; encode reserved characters in DSN credentials as URL percent escapes.
GRADEFLOW_COMPOSE_DATABASE_URL=postgresql+psycopg://gradeflow:local-only-change-me@postgres:5432/gradeflow

# Optional HTTPS frontend origin for a separately hosted API client; omit for Vite's same-origin proxy.
GRADEFLOW_FRONTEND_ORIGIN=

# Optional OpenAI-compatible vision provider; keep the API key only in the server environment.
GRADEFLOW_VISION_BASE_URL=
GRADEFLOW_VISION_MODEL=
GRADEFLOW_VISION_API_KEY=
GRADEFLOW_VISION_TIMEOUT_SECONDS=60

# Required for production registration, verification, and password-reset email delivery.
GRADEFLOW_SMTP_HOST=smtp.gmail.com
GRADEFLOW_SMTP_PORT=587
GRADEFLOW_SMTP_USER=bestigbekele5@gmail.com
GRADEFLOW_SMTP_PASSWORD=
GRADEFLOW_EMAIL_FROM=bestigbekele5@gmail.com

# Optional private S3-compatible object storage. Production requires every relevant value.
#GRADEFLOW_S3_ENDPOINT_URL=
#GRADEFLOW_S3_REGION=us-east-1
#GRADEFLOW_S3_BUCKET=
#GRADEFLOW_S3_ACCESS_KEY=
#GRADEFLOW_S3_SECRET_KEY=
#GRADEFLOW_S3_SERVER_SIDE_ENCRYPTION=true
GRADEFLOW_SUPABASE_URL=
GRADEFLOW_SUPABASE_STORAGE_BUCKET=gradeflow-scans
GRADEFLOW_SUPABASE_SERVICE_ROLE_KEY=